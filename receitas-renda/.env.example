# ============================================================================
# Central de Receitas & Renda — variáveis de ambiente
# Copie este arquivo para ".env" (desenvolvimento local) e configure as
# mesmas chaves em Vercel → Project Settings → Environment Variables.
# ============================================================================

# --- Supabase (frontend, /app e /admin) ---------------------------------
# Project Settings → API, em app.supabase.com. Seguras para o navegador:
# a proteção real dos dados é feita por Row Level Security no banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# --- Supabase (somente servidor — funções em /api) ----------------------
# NUNCA prefixe com VITE_ e nunca exponha no frontend. Usada pelo webhook da
# Hotmart e pelo convite de administradores para agir com privilégios totais.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# --- Hotmart --------------------------------------------------------------
# Ferramentas → Webhook, dentro do produto na Hotmart. Copie o "Hottok" aqui.
HOTMART_HOTTOK=seu-hottok-da-hotmart
