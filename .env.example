# ==========================================================
# LEUNAME SOFTWARE — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
# Nunca subas `.env.local` al repositorio.
# ==========================================================

# ---------- URL pública del sitio ----------
# En local: http://localhost:3000 — en producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase ----------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave `service_role`. SOLO servidor — nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe ----------
# Panel de Stripe → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks → firma del endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Pon "true" para calcular el IVA automáticamente con Stripe Tax
# (requiere activar Stripe Tax y registrar tus obligaciones fiscales).
STRIPE_TAX_ENABLED=false

# ---------- Resend (email transaccional) ----------
RESEND_API_KEY=
# Remitente verificado en Resend, ej: Leuname Software <compras@tudominio.com>
RESEND_FROM="Leuname Software <onboarding@resend.dev>"
# Copia oculta de cada compra para el equipo (opcional)
SALES_NOTIFICATION_EMAIL=

# ---------- Panel de administración ----------
# Emails con acceso a /admin, separados por coma.
# También funciona marcando el usuario con role = 'admin' en la tabla customers.
ADMIN_EMAILS=tu-email@ejemplo.com
