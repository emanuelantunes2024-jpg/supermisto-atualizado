# ==========================================================================
# CENTRAL DE RECEITAS & RENDA — variáveis de ambiente
#
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA envie o `.env.local` para o GitHub (ele já está no .gitignore).
#
# Na Vercel, cadastre as mesmas variáveis em:
# Project Settings → Environment Variables.
# ==========================================================================

# ---------- Endereço público do site ----------
# Local:      http://localhost:3000
# Produção:   https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (banco, login e fotos) ----------
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave `service_role`. SÓ no servidor, nunca no navegador.
# Usada pelo webhook da plataforma de venda para liberar e revogar acessos.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Painel administrativo ----------
# E-mails que podem entrar em /admin, separados por vírgula.
# Também funciona marcando papel = 'admin' na tabela `perfis`.
ADMIN_EMAILS=seu-email@exemplo.com

# ---------- Plataforma de venda (Hotmart e compatíveis) ----------
# O "hottok" do webhook: Hotmart → Ferramentas → Webhook (Postback).
# Sem ele, a rota /api/webhooks/hotmart responde 503 e não libera ninguém.
HOTMART_HOTTOK=

# Link da página de compra. Aparece nos botões da página pública.
# Enquanto estiver vazio, os botões levam para a demonstração.
NEXT_PUBLIC_LINK_OFERTA=

# Preço mostrado na página de vendas (apenas texto).
NEXT_PUBLIC_PRECO_OFERTA=29,90
