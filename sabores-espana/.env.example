# Estas variables se configuran en Cloudflare Pages → tu proyecto →
# Settings → Environment Variables (no en un archivo .env: eso es solo
# para pruebas locales, ver .dev.vars.example).

# ── Sesiones (obligatorio) ──────────────────────────────────────────────
# Cualquier texto largo y aleatorio. Firma las cookies de sesión (miembro y
# admin). Generalo con: openssl rand -hex 32
SESSION_SECRET=

# ── Hotmart (obligatorio para vender) ───────────────────────────────────
# Hotmart → tu producto → Herramientas → Webhook → copiar el "Hottok".
HOTMART_HOTTOK=

# ── Acceso de administrador (arranque inicial) ──────────────────────────
# Tu email, para entrar a /admin sin pasar por Hotmart.
ADMIN_EMAILS=tu-email@ejemplo.com
# Generalo con: node scripts/generar-clave-admin.mjs
ADMIN_PASSWORD_HASH=

# ── KV (Cloudflare Pages → Settings → Functions → KV namespace bindings) ─
# No es una variable de entorno: es un "binding" — se crea y se enlaza
# directamente en el dashboard, con el nombre exacto "SABORES_KV". Ver
# README.md → "Puesta en marcha (Cloudflare Pages)".
