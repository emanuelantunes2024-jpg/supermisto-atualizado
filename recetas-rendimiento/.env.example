# Variables de entorno del backend de suscripción (Vercel → Settings → Environment Variables).
# No se necesitan para desarrollar el diseño: solo para que /api/* funcione en producción.

# Cualquier cadena larga y aleatoria — firma la cookie de sesión.
SESSION_SECRET=

# Hotmart → Producto → Webhook → "Hottok". Verifica que la notificación sea de Hotmart.
HOTMART_HOTTOK=

# Emails con acceso total sin necesidad de comprar, y que pueden intentar
# iniciar sesión como administrador en /admin/entrar (separados por coma).
ADMIN_EMAILS=tu-email@ejemplo.com

# Hash de la contraseña del panel /admin — generalo con:
#   node scripts/gerar-senha-admin.mjs
# NUNCA pongas la contraseña en texto plano acá ni en el código.
ADMIN_PASSWORD_HASH=

# Estas dos las completa Vercel solo al agregar la integración de Redis
# (Storage → Marketplace → Redis). No hace falta escribirlas a mano.
# También son las que persisten las recetas/categorías que edite el admin.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
